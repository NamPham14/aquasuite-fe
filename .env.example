# AquaSuite Frontend Environment Variables
# Browser API base URL. This relative path uses the Vite proxy in development.
# In production, the hosting server must forward /api to the backend.
# An absolute URL bypasses the dev proxy and requires appropriate CORS settings.
VITE_API_BASE_URL=/api/v1

# Backend development server proxy target for Vite dev server
VITE_API_PROXY_TARGET=http://localhost:8080
