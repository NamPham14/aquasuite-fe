        </mxCell>
        <mxCell id="12" value="Tự giữ khi tiền đã xác minh đạt tối thiểu 20% giá trị yêu cầu giữ.&#10;Chưa đủ cọc: chưa phân bổ; “—” chưa xác định phần thiếu tồn. Giữ hàng không cho phép xuất kho." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="570" width="960" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Khoản cọc&#10;5.000.000 đ · Chuyển khoản · DEMO-001   |   Chờ xác minh&#10;Kết quả xác minh từ UC-70 (chỉ đọc). Kế toán xử lý tại UC-70." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="670" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Ghi nhận cọc qua UC-23&#10;Khoản thu mới chờ kế toán xác minh tại UC-70; kết quả hiển thị tại đây." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="815" width="960" height="75" as="geometry" />
        </mxCell>
        <mxCell id="18" value="[Ghi nhận cọc] → UC-23" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="910" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Lịch sử xử lý&#10;• Tạo yêu cầu giữ hàng, chưa phân bổ tồn.&#10;• Ghi nhận cọc qua UC-23, chờ xác minh tại UC-70." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="985" width="960" height="120" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Còn thiếu để đủ cọc = max(0, cọc tối thiểu − tiền đã xác minh).&#10;Còn phải thu toàn đơn = tổng đơn − tiền đã xác minh.&#10;Tiền chờ xác minh chưa làm giảm hai số này; UC-23 kiểm soát số tiền có thể ghi nhận." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="1125" width="960" height="110" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Dialog cuộn dọc; bảng hàng cuộn ngang trên màn hình nhỏ.&#10;Escape / nút X đóng; trả focus về nút mở. Khóa gửi lặp khi xử lý." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
