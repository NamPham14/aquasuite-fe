        <mxCell id="19" value="Lịch sử xử lý&#10;• UC-70: cọc đã xác minh đủ 5.000.000 đ.&#10;• Tự giữ hàng thất bại; có thể thử giữ lại, không ghi nhận cọc mới." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="985" width="960" height="120" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Sau thử lại: hiển thị số đã giữ thực tế và số chờ bổ sung theo từng dòng.&#10;Ví dụ: Yêu cầu giữ 10 / Đã giữ 8 / Chờ bổ sung 2 / Trạng thái: Chờ bổ sung hàng.&#10;Đang xử lý: khóa nút thử lại; không cộng trùng số đã giữ." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="1125" width="960" height="110" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Dialog cuộn dọc; bảng hàng cuộn ngang trên màn hình nhỏ.&#10;Escape / nút X đóng; trả focus về nút mở. Khóa gửi lặp khi xử lý." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
