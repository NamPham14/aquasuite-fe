        <mxCell id="13" value="Validation&#10;Chọn khách, ít nhất một dòng cần giữ.&#10;Số mua: 1–9.999; số giữ: 0–số mua; ngày giao không trong quá khứ.&#10;Cọc: VND nguyên dương, không vượt số có thể thu. Chuyển khoản cần tham chiếu." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff1f2;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="850" height="150" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Responsive / bàn phím&#10;Danh sách dọc trên mobile; dialog tối đa 94vw / 90vh.&#10;Control có label; bảng cuộn ngang có thể focus; focus ring theo component chung.&#10;Không thêm theme hoặc CSS toàn cục." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="850" height="140" as="geometry" />
